# Data & artifacts (large files)
# Track processed/ and movies_games.db so `make export` works from a clone.
# Raw JSONL is kept out — it's huge and rebuildable from the Amazon 2023 dump.
ml/data/amazon_2023/raw/
data/processed/
artifacts/*
*.faiss
*.ann
*.pt
*.pth
*.bin
*.pkl
*.pickle
*.h5
*.npy
*.npz
# Re-include demo artifacts (used to ship pre-built embeddings/catalog).
# Must come AFTER the *.npy / *.json catch-alls so negations win.
!artifacts/demo/
!artifacts/demo/*.npy
!artifacts/demo/*.json

# Node
frontend/node_modules/
frontend/.next/
frontend/out/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# TensorBoard event runs
log_tensorboard/
ml/log_tensorboard/
ml/scripts/benchmarks/log_tensorboard/

# Coverage
htmlcov/
.coverage
.pytest_cache/

# Claude Code
.claude/

# SQLite WAL/SHM session files (regenerated automatically)
data/demo.db-shm
data/demo.db-wal
